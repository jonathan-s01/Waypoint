{
  "bundle": "com.microsoft.teams2",
  "name": "Microsoft Teams",
  "view": {
    "kind": "panes",
    "panes": {
      "parts": [
        {
          "name": "Search",
          "match": { "role": "AXComboBox", "inside": { "subrole": "AXLandmarkSearch" } }
        },
        {
          "name": "Apps",
          "match": { "subrole": "AXLandmarkNavigation", "description": "Apps" },
          "hint": "Chat, Calendar, Calls and the other Teams apps."
        },
        {
          "name": "Chat filters",
          "match": { "role": "AXToolbar", "description": "Filter options" }
        },
        {
          "name": "Chat list",
          "match": { "role": "AXOutline", "description": "Teams" },
          "hint": "Up and Down choose a chat or channel."
        },
        {
          "name": "Chat tabs",
          "match": { "role": "AXTabGroup" }
        },
        {
          "name": "Chat actions",
          "match": { "role": "AXToolbar", "description": "Chat actions" }
        },
        {
          "name": "Messages",
          "match": { "role": "AXGroup", "description": "Message List" },
          "read": "document",
          "hint": "Arrows read the messages. H and Shift H move by message."
        },
        {
          "name": "Message box",
          "match": { "role": "AXTextArea", "description": "Type a message" }
        }
      ],
      "alternates": [
        {
          "name": "Call window",
          "when": { "role": "AXToolbar", "description": "Meeting controls" },
          "parts": [
            {
              "name": "Meeting controls",
              "match": { "role": "AXToolbar", "description": "Meeting controls" },
              "hint": "Raise, React, View, Controls, Copilot, More, camera, microphone and Share."
            },
            {
              "name": "Calling controls",
              "match": { "subrole": "AXApplicationGroup", "description": "Calling controls" },
              "hint": "Leave the call."
            },
            {
              "name": "Call stage",
              "match": { "subrole": "AXLandmarkMain", "description": "Shared content view" },
              "hint": "Who is in the call and what is shared."
            },
            {
              "name": "Calling indicators",
              "match": { "role": "AXToolbar", "description": "Calling indicators" },
              "hint": "Encryption and how long the call has lasted."
            }
          ]
        }
      ]
    }
  }
}
